# Application
APP_NAME=JANA ADDRESS API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL. Replace change_me locally; never commit the real password.
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/jana_address_db
DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:change_me@host.docker.internal:5432/jana_address_db

# Frontend and request limits
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
MAX_BATCH_SIZE=20000
MAX_UPLOAD_BYTES=10485760
