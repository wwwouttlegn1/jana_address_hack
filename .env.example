# Application
APP_NAME=JANA ADDRESS API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL for direct local backend development.
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/jana_address_db

# Autonomous Docker Compose stack. Replace change_me only in the ignored .env.
POSTGRES_DB=jana_address_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend and request limits
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
MAX_BATCH_SIZE=20000
MAX_UPLOAD_BYTES=10485760
